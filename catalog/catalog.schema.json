{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/FrancescoCorbosiero/hive-compliance/catalog/catalog.schema.json",
	"title": "hive-compliance document catalog",
	"type": "object",
	"required": [ "catalog_version", "documents" ],
	"additionalProperties": false,
	"properties": {
		"$schema": { "type": "string" },
		"catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
		"baseline": { "type": "string" },
		"updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
		"documents": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/document" }
		}
	},
	"$defs": {
		"texts": {
			"type": "object",
			"minProperties": 1,
			"required": [ "en" ],
			"propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
			"additionalProperties": { "type": "string", "minLength": 1 }
		},
		"document": {
			"type": "object",
			"required": [ "id", "title", "type", "group", "applies_when", "required_elements", "placeholders_used", "legal_refs", "review_cadence_months", "checklist_status" ],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
				"title": {
					"type": "object",
					"minProperties": 1,
					"required": [ "en" ],
					"propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
					"additionalProperties": { "type": "string", "minLength": 1 }
				},
				"type": { "enum": [ "page", "fragment", "internal" ] },
				"group": { "enum": [ "core", "conditional", "international", "fragment", "internal" ] },
				"description": { "type": "string" },
				"applies_when": { "$ref": "#/$defs/rule" },
				"required_elements": {
					"type": "array",
					"items": { "$ref": "#/$defs/element" }
				},
				"placeholders_used": {
					"type": "array",
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/placeholder" }
				},
				"legal_refs": {
					"type": "array",
					"items": { "type": "string", "minLength": 1 }
				},
				"review_cadence_months": { "type": "integer", "minimum": 1, "maximum": 60 },
				"checklist_status": { "enum": [ "complete", "draft" ] },
				"lint": {
					"type": "array",
					"items": { "$ref": "#/$defs/lint" }
				}
			}
		},
		"element": {
			"type": "object",
			"required": [ "key", "label", "legal_ref" ],
			"additionalProperties": false,
			"properties": {
				"key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
				"label": {
					"description": "Heading label per language (BCP-47 code => text, English required), or one English string.",
					"oneOf": [
						{ "type": "string", "minLength": 1 },
						{ "$ref": "#/$defs/texts" }
					]
				},
				"legal_ref": { "type": "string" },
				"placeholders": {
					"type": "array",
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/placeholder" }
				}
			}
		},
		"placeholder": {
			"type": "string",
			"pattern": "^(business|store|links|custom)\\.[a-z0-9_]+$"
		},
		"lint": {
			"type": "object",
			"required": [ "id", "pattern", "severity", "message" ],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
				"pattern": { "type": "string", "minLength": 1 },
				"severity": { "enum": [ "error", "warning" ] },
				"message": { "type": "string", "minLength": 1 }
			}
		},
		"rule": {
			"oneOf": [
				{
					"type": "object",
					"required": [ "always" ],
					"additionalProperties": false,
					"properties": { "always": { "const": true } }
				},
				{
					"type": "object",
					"required": [ "all" ],
					"additionalProperties": false,
					"properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
				},
				{
					"type": "object",
					"required": [ "any" ],
					"additionalProperties": false,
					"properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } } }
				},
				{
					"type": "object",
					"required": [ "not" ],
					"additionalProperties": false,
					"properties": { "not": { "$ref": "#/$defs/condition" } }
				}
			]
		},
		"condition": {
			"oneOf": [
				{ "$ref": "#/$defs/rule" },
				{ "$ref": "#/$defs/comparison" }
			]
		},
		"comparison": {
			"oneOf": [
				{
					"type": "object",
					"required": [ "field", "op" ],
					"additionalProperties": false,
					"properties": {
						"field": { "$ref": "#/$defs/field" },
						"op": { "const": "true" }
					}
				},
				{
					"type": "object",
					"required": [ "field", "op", "value" ],
					"additionalProperties": false,
					"properties": {
						"field": { "$ref": "#/$defs/field" },
						"op": { "enum": [ "eq", "in", "includes" ] },
						"value": { "type": [ "string", "boolean", "number", "array" ] }
					}
				}
			]
		},
		"field": {
			"enum": [
				"seller_country",
				"is_micro_enterprise",
				"markets",
				"customer_types",
				"product_types",
				"product_flags",
				"features",
				"market_regions",
				"sells_outside_eu",
				"seller_in_eu"
			]
		}
	}
}
